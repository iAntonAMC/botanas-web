---
import type { Snack } from "../data/snacks";

interface Props {
  snack: Snack;
}

const { snack } = Astro.props;
---

<article
  class="group overflow-hidden rounded-2xl
           border-2 border-black bg-primary-fixed p-4"
>
  <div class="relative">
    <img
      src={snack.image}
      alt={snack.name}
      class="aspect-square w-full rounded-xl
                   object-cover"
    />

    {
      snack.badge && (
        <span
          class="absolute left-3 top-3 rounded-full
                       border-2 border-black bg-secondary
                       px-3 py-1 text-sm font-bold text-white"
        >
          {snack.badge}
        </span>
      )
    }
  </div>

  <div class="mt-4">
    <span class="text-sm font-bold uppercase text-secondary">
      {snack.category}
    </span>

    <h3 class="mt-1 text-2xl font-black">
      {snack.name}
    </h3>

    <p class="mt-2 text-on-surface-variant">
      {snack.description}
    </p>

    <div class="mt-4 flex items-center justify-between">
      <strong class="text-2xl font-black">
        ${snack.price}
      </strong>

      <button
        type="button"
        class="rounded-xl border-2 border-black
                       bg-secondary px-4 py-2
                       font-bold text-white"
        data-product-trigger
        data-id={snack.id}
      >
        Ver Detalles
      </button>
    </div>
  </div>
</article>
