---
import type { Snack } from "../data/snacks";

interface Props {
  products: Snack[];
}

const { products } = Astro.props;
---

<div
  id="product-modal"
  class="fixed inset-0 z-[100] hidden
           items-center justify-center
           bg-black/60 p-4 backdrop-blur-sm
           md:p-8"
  aria-hidden="true"
>
  <div
    id="product-modal-content"
    role="dialog"
    aria-modal="true"
    aria-labelledby="modal-title"
    class="relative max-h-[90vh] w-full max-w-4xl
               overflow-y-auto
               rounded-2xl border-4 border-black
               bg-secondary
               shadow-[8px_8px_0_0_#000]"
  >
    <!-- Confetti Background -->
    <div
      aria-hidden="true"
      class="pointer-events-none absolute inset-0 opacity-70"
    >
    </div>

    <!-- CLOSE -->
    <button
      id="modal-close"
      type="button"
      aria-label="Cerrar detalles del producto"
      class="absolute right-3 top-3 z-30
                   flex h-11 w-11 items-center
                   justify-center rounded-full
                   border-2 border-black
                   bg-surface
                   shadow-[3px_3px_0_0_#000]
                   transition-transform
                   hover:-translate-y-1"
    >
      <span class="material-symbols-outlined"> close </span>
    </button>

    <div class="relative grid grid-cols-1 gap-5 p-5 md:grid-cols-2 md:p-7">
      <!-- IMAGE -->
      <div class="relative">
        <div
          class="aspect-square overflow-hidden
                           rounded-2xl border-4 border-black
                           bg-surface
                           shadow-[4px_4px_0_0_#000]"
        >
          <img
            id="modal-image"
            src=""
            alt=""
            class="h-full w-full object-cover"
          />
        </div>

        <!-- Seal -->
        <div
          class="absolute -bottom-4 left-2
                           rotate-[-6deg]
                           rounded-md border-2 border-black
                           bg-tertiary-fixed px-3 py-2
                           font-body-md text-sm font-bold
                           shadow-[3px_3px_0_0_#000]"
        >
          <span aria-hidden="true">✿</span>
          Hecho en México
        </div>
      </div>

      <!-- DETAILS -->
      <div class="flex flex-col gap-4">
        <!-- Title + Price -->
        <div
          class="rounded-xl border-4 border-black
                           bg-primary-fixed p-4
                           shadow-[4px_4px_0_0_#000]"
        >
          <h2
            id="modal-title"
            class="font-display-lg text-3xl
                               font-black text-on-surface"
          >
            Producto
          </h2>

          <p
            id="modal-price"
            class="mt-1 font-display-lg text-2xl
                               font-black text-secondary"
          >
            $0.00
          </p>
        </div>

        <!-- Description -->
        <section
          class="rounded-xl border-2 border-black
                           bg-surface p-4"
        >
          <h3
            class="mb-2 font-body-md text-xs
                               font-bold uppercase tracking-wide
                               text-on-surface-variant"
          >
            Descripción
          </h3>

          <p
            id="modal-description"
            class="font-body-md text-sm
                               leading-6 text-on-surface md:text-base"
          >
          </p>
        </section>

        <!-- Ingredients -->
        <section
          class="rounded-xl border-2 border-black
                           bg-surface p-4"
        >
          <h3
            class="mb-2 font-body-md text-xs
                               font-bold uppercase tracking-wide
                               text-on-surface-variant"
          >
            Ingredientes
          </h3>

          <p
            id="modal-ingredients"
            class="font-body-md text-sm italic
                               leading-6 text-on-surface"
          >
          </p>
        </section>

        <!-- Actions -->
        <div class="mt-auto flex flex-col gap-3">
          <button
            id="modal-order"
            type="button"
            class="rounded-xl border-4 border-black
                               bg-primary-container py-4
                               font-display-lg text-xl
                               font-black
                               text-on-primary-container
                               shadow-[4px_4px_0_0_#000]
                               transition-all
                               hover:-translate-y-1
                               active:translate-y-0"
          >
            ¡Lo Quiero!
          </button>

          <button
            id="modal-close-secondary"
            type="button"
            class="rounded-xl border-2 border-black
                               bg-surface py-2
                               font-body-md font-medium
                               text-on-surface
                               transition-colors
                               hover:bg-secondary-fixed"
          >
            Cerrar
          </button>
        </div>
      </div>
    </div>
  </div>
</div>

<script define:vars={{ products }}>
  const modal = document.querySelector("#product-modal");
  const modalContent = document.querySelector("#product-modal-content");

  const modalTitle = document.querySelector("#modal-title");
  const modalPrice = document.querySelector("#modal-price");
  const modalImage = document.querySelector("#modal-image");
  const modalDescription = document.querySelector("#modal-description");
  const modalIngredients = document.querySelector("#modal-ingredients");

  const closeButton = document.querySelector("#modal-close");
  const closeSecondaryButton = document.querySelector("#modal-close-secondary");

  const triggers = document.querySelectorAll("[data-product-trigger]");

  function openModal(productId) {
    const product = products.find((item) => item.id === productId);

    if (!product || !modal) return;

    modalTitle.textContent = product.name;

    modalPrice.textContent = `$${product.price.toFixed(2)}`;

    modalImage.src = product.image;
    modalImage.alt = product.name;

    modalDescription.textContent = product.description;

    modalIngredients.textContent = product.ingredients.join(", ");

    modal.classList.remove("hidden");
    modal.classList.add("flex");

    modal.setAttribute("aria-hidden", "false");

    document.body.style.overflow = "hidden";

    closeButton?.focus();
  }

  function closeModal() {
    if (!modal) return;

    modal.classList.add("hidden");
    modal.classList.remove("flex");

    modal.setAttribute("aria-hidden", "true");

    document.body.style.overflow = "";
  }

  triggers.forEach((trigger) => {
    trigger.addEventListener("click", () => {
      const productId = trigger.getAttribute("data-product-trigger");

      if (productId) {
        openModal(productId);
      }
    });
  });

  closeButton?.addEventListener("click", closeModal);

  closeSecondaryButton?.addEventListener("click", closeModal);

  modal?.addEventListener("click", (event) => {
    if (event.target === modal) {
      closeModal();
    }
  });

  document.addEventListener("keydown", (event) => {
    if (
      event.key === "Escape" &&
      modal &&
      !modal.classList.contains("hidden")
    ) {
      closeModal();
    }
  });
</script>
