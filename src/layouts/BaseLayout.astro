---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Botanas Lokas | El Sabor de México",
  description = "Botanas mexicanas con mucho sabor, chile y tradición.",
} = Astro.props;
---

<!doctype html>
<html lang="es-MX">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffe16d" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Anybody:wdth,wght@75..125,400..900&family=Be+Vietnam+Pro:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL@20..48,100..700,0..1&display=swap"
      rel="stylesheet"
    />
  </head>
  <body><slot /></body>
</html>

<style is:global>
  :root {
    color-scheme: light;
    font-family: "Be Vietnam Pro", sans-serif;
    background: #fcf9f8;
    color: #1c1b1b;
  }
  h1,
  h2 {
    font-family: "Anybody", sans-serif;
    display-font: swap;
  }
  html {
    scroll-behavior: smooth;
    scroll-padding-top: 6.5rem;
  }
  .material-symbols-outlined {
    line-height: 1;
    vertical-align: middle;
  }
</style>

<style>
  body {
    min-width: 320px;
    min-height: 100vh;
    margin: 0;
    overflow-x: hidden;
    background-color: #fcf9f8;
    background-image: radial-gradient(
      rgba(28, 27, 27, 0.055) 1px,
      transparent 1px
    );
    background-size: 18px 18px;
  }
  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }
  ::selection {
    background: #e2007b;
    color: #fff;
  }
  :focus-visible {
    outline: 3px solid #e2007b;
    outline-offset: 4px;
  }
</style>
